# ════════════════════════════════════════════
# XiaoYue - WeCom AI Girlfriend Bot
# cp .env.example .env
# ════════════════════════════════════════════

# --- DeepSeek API (Required) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- AI Parameters ---
# AI_TEMPERATURE=0.95
# AI_MAX_TOKENS=500
# AI_MAX_RETRIES=3
# AI_REQUEST_TIMEOUT=45

# --- WeCom (企业微信) - Get these from WeCom Admin ---
# Step 1: Register at https://work.weixin.qq.com/
# Step 2: Create an app in Application Management
# Step 3: Copy Corp ID, Agent ID, Secret
# Step 4: Set callback URL to: https://your-domain/callback
# Step 5: Generate random Token and AES Key
WECOM_CORP_ID=
WECOM_AGENT_ID=1000002
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# Only reply to this user's WeCom ID (empty = all users)
WECOM_ALLOWED_USER=

# --- Human Simulation ---
# HUMAN_DELAY_MIN=3.0
# HUMAN_DELAY_MAX=15.0
# HUMAN_REPLY_RATE=0.95
# HUMAN_MAX_PER_HOUR=50
# HUMAN_MAX_PER_DAY=300
# HUMAN_ACTIVE_START=7
# HUMAN_ACTIVE_END=24
# HUMAN_AFK_INTERVAL=3.0
# HUMAN_AFK_MIN=5
# HUMAN_AFK_MAX=30

# --- Session ---
SESSION_DIR=sessions
SESSION_FILE=sessions.json
MAX_HISTORY=20
SESSION_BACKUP=true
